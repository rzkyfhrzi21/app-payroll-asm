APP_NAME="Payroll ASM"
APP_ENV=production
# Format: base64:... (generate di server dengan `php artisan key:generate`, jangan commit nilai asli)
APP_KEY=
APP_DEBUG=false
APP_URL=https://nabela-payroll.web.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ------------------------------------------------------------------------------
# Database: TiDB Cloud Serverless (MySQL Compatible, wajib TLS/SSL)
# ------------------------------------------------------------------------------
DB_CONNECTION=mysql
DB_HOST=gateway01.ap-southeast-1.prod.aws.tidbcloud.com
DB_PORT=4000
DB_DATABASE=app-payroll-asm
DB_USERNAME=xxxxxx.root
DB_PASSWORD=
# Ubuntu 24.04 LTS: /etc/ssl/certs/ca-certificates.crt
MYSQL_ATTR_SSL_CA=/etc/ssl/certs/ca-certificates.crt
# MYSQL_ATTR_SSL_VERIFY_SERVER_CERT=true

# ------------------------------------------------------------------------------
# Session, Cache, Queue, & Filesystem
# Catatan: Gunakan `file` untuk SESSION_DRIVER & CACHE_STORE bila ingin
# mengurangi latensi round-trip query ke TiDB Cloud di setiap request.
# ------------------------------------------------------------------------------
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# ------------------------------------------------------------------------------
# SMTP Email (Notifikasi Slip Gaji Supir)
# Gunakan 16 digit Google App Password (bukan password akun biasa).
# ------------------------------------------------------------------------------
MAIL_MAILER=smtp
MAIL_HOST=smtp.gmail.com
MAIL_PORT=587
MAIL_SCHEME=null
MAIL_USERNAME="akunpengirim@gmail.com"
MAIL_PASSWORD=""
MAIL_FROM_ADDRESS="${MAIL_USERNAME}"
MAIL_FROM_NAME="${APP_NAME}"

# ------------------------------------------------------------------------------
# Gateway WhatsApp Fonnte (https://fonnte.com)
# Kosongkan FONNTE_TOKEN jika fitur notifikasi WA dinonaktifkan.
# ------------------------------------------------------------------------------
FONNTE_TOKEN=
FONNTE_URL=https://api.fonnte.com/send
FONNTE_AKTIF=true
FONNTE_TIMEOUT=15

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Wajib false di production
DEBUGBAR_ENABLED=false

# ------------------------------------------------------------------------------
# Identitas Pengembang / Peneliti (Author)
# Kosongkan = menggunakan nilai default di config/app.php
# ------------------------------------------------------------------------------
AUTHOR_NAMA="Nabela Septiara"
AUTHOR_NPM="2311050052"
AUTHOR_INSTAGRAM="nbelaasp_"
AUTHOR_EMAIL="septiaranabila559@gmail.com"
AUTHOR_WHATSAPP="085760898417"
AUTHOR_JUDUL="Payroll System pada PT ASM Lampung"
AUTHOR_DOSBING="Bu Ayu Firdhayanti, S.Kom., M.T.I"
AUTHOR_ALAMAT="Kosan Dakwah"
