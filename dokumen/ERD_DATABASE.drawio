        <mxCell id="leg_0" value="&lt;b&gt;[PK]&lt;/b&gt; Primary Key (BIGINT UNSIGNED AUTO_INCREMENT) · &lt;b&gt;[FK]&lt;/b&gt; Foreign Key berelasi ke tabel induk" style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=none;strokeColor=none;fontColor=#333333;fontSize=10.5;" vertex="1" parent="legend">
          <mxGeometry x="0" y="34" width="850" height="24" as="geometry" />
        </mxCell>
        <mxCell id="leg_1" value="&lt;b&gt;Presisi Angka:&lt;/b&gt; Seluruh kolom uang (Rupiah) dan berat (tonase_kg) bertipe BIGINT bulat tanpa desimal; komisi disimpan dalam basis poin (SMALLINT, 1000 = 10,00%)." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=none;strokeColor=none;fontColor=#333333;fontSize=10.5;" vertex="1" parent="legend">
          <mxGeometry x="0" y="58" width="850" height="24" as="geometry" />
        </mxCell>
        <mxCell id="leg_2" value="&lt;b&gt;Siklus Buka/Tutup Buku:&lt;/b&gt; Hanya ada 1 periode_gaji aktif (tanggal_selesai = NULL). Saat tutup buku, tanggal_selesai dikunci &amp; periode baru otomatis dibuka (H+1)." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=none;strokeColor=none;fontColor=#333333;fontSize=10.5;" vertex="1" parent="legend">
          <mxGeometry x="0" y="82" width="850" height="24" as="geometry" />
        </mxCell>
        <mxCell id="leg_3" value="&lt;b&gt;Proteksi Master &amp; SoftDeletes:&lt;/b&gt; Tabel master (karyawan, truk, jenis_truk, rute, kasbon) memakai SoftDeletes (deleted_at) &amp; tidak boleh dihapus bila sudah memiliki transaksi." style="text;html=1;align=left;verticalAlign=middle;spacingLeft=10;fillColor=none;strokeColor=none;fontColor=#333333;fontSize=10.5;" vertex="1" parent="legend">
